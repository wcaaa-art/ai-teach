{
  "name": "ai-teach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "test": "node --test",
    "bank:build": "node scripts/build-question-bank.js",
    "bank:build:quiz": "node scripts/build-quiz-bank.js",
    "rag:build": "python scripts/build-rag-index.py",
    "rag:build-vector": "node scripts/build-rag-vector.mjs",
    "rag:eval": "node server/rag/rag-eval.js",
    "rag:compare": "node server/rag/rag-eval.js --compare",
    "mcp": "node server/mcp.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint src server scripts",
    "lint:fix": "eslint src server scripts --fix",
    "rag:rerank:eval": "node server/rag/rag-rerank-eval.js",
    "safety:eval": "node scripts/safety-eval.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^0.10.22",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "echarts": "^5.6.0",
    "echarts-gl": "^2.0.9",
    "element-plus": "2.11.8",
    "express": "^4.21.2",
    "idb": "^8.0.2",
    "pinia": "^3.0.1",
    "tesseract.js": "^6.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.2.0"
  }
}
