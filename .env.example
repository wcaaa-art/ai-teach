# 后端端口
PORT=3001
# 允许访问 API 的前端来源，多个用逗号分隔；生产环境改成实际域名
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
# 大模型配置；不填 key 时自动降级为本地题库/规则
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-flash
DEEPSEEK_API_KEY=sk-replace-with-your-own-key
# 前端请求前缀；前后端分域部署时改成后端完整地址
VITE_API_BASE_URL=/api
# 登录会话签名密钥，至少 32 个字符；留空会自动生成到 server/data/session-secret
AUTH_SESSION_SECRET=
# 可选开关：1 开启 / 0 关闭（默认值即下面注释里的值）
# RAG_HYBRID=0
# RAG_EXPAND=1
# RAG_RERANK=1
# SAFETY_SCREEN=1
# Agent 规划层：先规划工具步骤再回答；置 0 回退到原工具循环
# AGENT_PLANNER=1
# AGENT_PLAN_TIMEOUT_MS=12000
